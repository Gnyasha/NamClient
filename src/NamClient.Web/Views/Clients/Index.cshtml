@model ListPageViewModel<ClientListItemViewModel>
@{
    ViewData["Title"] = "Clients";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Clients</h1>
        <p class="page-subtitle">Right-click a row for more actions.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary"><icon name="plus" /> New client</a>
    </div>
</div>

<section class="app-card" aria-label="Client list"
         data-list
         data-url="@Url.Action("Index")"
         data-export-url="@Url.Action("Export")"
         data-delete-url="@Url.Action("Delete")"
         data-noun="client"
         data-noun-plural="clients">

    @await Html.PartialAsync("_ListToolbar", new ListToolbarViewModel(
        Url.Action("Index")!, "clients", "Search clients, e.g. bank or FNB001", Model.Request.Search, Model.Request.PageSize))

    <div data-list-body>
        <partial name="_ClientsTable" model="Model" />
    </div>
</section>

@section Scripts {
    <script src="~/js/list-page.js" asp-append-version="true"></script>
}
