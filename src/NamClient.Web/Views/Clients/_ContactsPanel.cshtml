@model ClientContactsPanelViewModel

@if (Model.Status is not null)
{
    <partial name="_StatusMessage" model="Model.Status" />
}
<div hidden data-linked-count="@Model.Contacts.Count"></div>

<div class="panel-toolbar">
    <div class="toolbar-main" data-toolbar-default>
        <span class="text-muted-app">Linked contacts</span>
        <div class="toolbar-spacer"></div>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#link-picker">
            <icon name="link" /> Link contacts
        </button>
    </div>
    <div class="bulk-bar" data-toolbar-bulk hidden>
        <span class="bulk-count" data-bulk-count aria-live="polite"></span>
        <button type="button" class="btn btn-outline-danger btn-sm" data-bulk-unlink><icon name="unlink" /> Unlink selected</button>
        <div class="toolbar-spacer"></div>
        <button type="button" class="btn btn-light btn-sm" data-bulk-clear><icon name="x" /> Clear selection</button>
    </div>
</div>

@if (Model.Contacts.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><icon name="users" /></div>
        <p class="empty-message">No contacts found.</p>
    </div>
}
else
{
    <div class="data-table-wrap">
        <table class="table table-hover data-table align-middle">
            <caption class="visually-hidden">Contacts linked to this client. Right-click a row for actions.</caption>
            <thead>
                <tr>
                    <th class="col-select" scope="col">
                        <input class="form-check-input" type="checkbox" data-select-all aria-label="Select all linked contacts" />
                    </th>
                    <th class="text-start" scope="col">Contact Full Name</th>
                    <th class="text-start" scope="col">Contact email address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in Model.Contacts)
                {
                    <tr data-href="@Url.Action("Edit", "Contacts", new { id = contact.ContactId })" data-id="@contact.ContactId" data-label="@contact.FullName">
                        <td class="col-select">
                            <input class="form-check-input" type="checkbox" data-select value="@contact.ContactId" aria-label="Select @contact.FullName" />
                        </td>
                        <td class="text-start">
                            <a class="row-title" asp-controller="Contacts" asp-action="Edit" asp-route-id="@contact.ContactId">@contact.FullName</a>
                        </td>
                        <td class="text-start">@contact.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
