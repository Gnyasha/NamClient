@using NamClient.Web.Infrastructure
@model ClientFormViewModel
@{
    var heading = Model.IsNew ? "New client" : string.IsNullOrWhiteSpace(Model.Name) ? "Edit client" : Model.Name;
    ViewData["Title"] = heading;
}

<a class="back-link" asp-action="Index"><icon name="arrow-left" /> All clients</a>

<div class="page-header">
    <div>
        <h1 class="page-title">@heading</h1>
        @if (Model.IsNew)
        {
            <p class="page-subtitle">The client code is generated on save.</p>
        }
        else
        {
            <div class="record-meta">
                <span class="code-badge" title="Client code">@Model.ClientCode</span>
                <span><icon name="clock" /> Created @DateDisplay.Local(Model.CreatedAt)</span>
                <span>Last updated @DateDisplay.Local(Model.UpdatedAt)</span>
            </div>
        }
    </div>

    @if (!Model.IsNew)
    {
        <form class="page-actions" asp-action="Delete" method="post">
            <input type="hidden" name="ids" value="@Model.ClientId" />
            <button type="submit" class="btn btn-outline-danger"
                    data-confirm-submit="This permanently deletes the client and removes its links to contacts. The contacts themselves are kept. This can't be undone."
                    data-confirm-title="Delete this client?"
                    data-busy-label="Deleting…">
                <icon name="trash" /> Delete client
            </button>
        </form>
    }
</div>

<div class="app-card">
    <ul class="nav app-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-tab" type="button" role="tab"
                    data-bs-toggle="tab" data-bs-target="#general" data-tab-hash="general"
                    aria-controls="general" aria-selected="true">General</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="contacts-tab" type="button" role="tab"
                    data-bs-toggle="tab" data-bs-target="#contacts" data-tab-hash="contacts"
                    aria-controls="contacts" aria-selected="false">
                Contact(s)
                @if (!Model.IsNew)
                {
                    <span class="tab-count" data-tab-count hidden></span>
                }
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active app-card-body" id="general" role="tabpanel" aria-labelledby="general-tab" tabindex="0">
            <form class="form-narrow" asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.ClientId" method="post" novalidate
                  data-dirty-check="@(Model.IsNew ? null : ViewData.ModelState.IsValid ? "clean" : "start-dirty")">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label required"></label>
                    <input asp-for="Name" class="form-control" autocomplete="off" autofocus />
                    <span asp-validation-for="Name"></span>
                </div>

                @if (!Model.IsNew)
                {
                    <div class="mb-4">
                        <label asp-for="ClientCode" class="form-label required"></label>
                        <input asp-for="ClientCode" class="form-control" readonly />
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" data-dirty-submit
                            disabled="@(!Model.IsNew && ViewData.ModelState.IsValid)">
                        <icon name="check" /> @(Model.IsNew ? "Create client" : "Save changes")
                    </button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </div>
            </form>
        </div>

        <div class="tab-pane fade" id="contacts" role="tabpanel" aria-labelledby="contacts-tab" tabindex="0">
            @if (Model.IsNew)
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><icon name="users" /></div>
                    <p class="empty-message">Save the client first</p>
                    <p class="empty-hint">You can link contacts once the client has been created.</p>
                </div>
            }
            else
            {
                <div data-link-panel data-load-url="@Url.Action("Contacts", new { id = Model.ClientId })"
                     data-unlink-url="@Url.Action("UnlinkContacts", new { id = Model.ClientId })"
                     data-field-name="contactIds" data-noun="contact" data-noun-plural="contacts"
                     data-owner="this client">
                    <div class="empty-state"><div class="spinner-border text-secondary" role="status"><span class="visually-hidden">Loading contacts…</span></div></div>
                </div>
            }
        </div>
    </div>
</div>

@if (!Model.IsNew)
{
    @await Html.PartialAsync("_LinkPickerModal", new LinkPickerViewModel(
        "Link contacts",
        "contact",
        "contacts",
        Url.Action("ContactOptions", new { id = Model.ClientId })!,
        Url.Action("LinkContacts", new { id = Model.ClientId })!,
        "contactIds",
        "Search by name, surname or email"))
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/link-panel.js" asp-append-version="true"></script>
}
