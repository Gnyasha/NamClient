@model LinkPickerViewModel
<div class="modal fade" id="link-picker" tabindex="-1" aria-labelledby="link-picker-title" aria-hidden="true"
     data-options-url="@Model.OptionsUrl" data-link-url="@Model.LinkUrl" data-field-name="@Model.FieldName"
     data-noun="@Model.Noun" data-noun-plural="@Model.NounPlural">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="link-picker-title">@Model.Title</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="search-box mw-100 mb-3">
                    <icon name="search" />
                    <label for="picker-search" class="visually-hidden">Search @Model.NounPlural</label>
                    <input id="picker-search" class="form-control" type="search" placeholder="@Model.SearchPlaceholder"
                           autocomplete="off" maxlength="100" data-picker-search />
                </div>
                <div class="picker-results" data-picker-results></div>
                <div class="field-validation-error" role="alert" data-picker-error hidden>
                    Please select at least one @Model.Noun to link.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-picker-submit data-busy-label="Linking…">Link @Model.NounPlural</button>
            </div>
        </div>
    </div>
</div>
