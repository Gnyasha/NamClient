@using NamClient.Web.Infrastructure
@model ContactFormViewModel
@{
    var fullName = $"{Model.Surname} {Model.Name}".Trim();
    var heading = Model.IsNew ? "New contact" : string.IsNullOrWhiteSpace(fullName) ? "Edit contact" : fullName;
    ViewData["Title"] = heading;
}

<a class="back-link" asp-action="Index"><icon name="arrow-left" /> All contacts</a>

<div class="page-header">
    <div>
        <h1 class="page-title">@heading</h1>
        @if (!Model.IsNew)
        {
            <div class="record-meta">
                <span>@Model.Email</span>
                <span><icon name="clock" /> Created @DateDisplay.Local(Model.CreatedAt)</span>
                <span>Last updated @DateDisplay.Local(Model.UpdatedAt)</span>
            </div>
        }
    </div>

    @if (!Model.IsNew)
    {
        <form class="page-actions" asp-action="Delete" method="post">
            <input type="hidden" name="ids" value="@Model.ContactId" />
            <button type="submit" class="btn btn-outline-danger"
                    data-confirm-submit="This permanently deletes the contact and removes its links to clients. The clients themselves are kept. This can't be undone."
                    data-confirm-title="Delete this contact?"
                    data-busy-label="Deleting…">
                <icon name="trash" /> Delete contact
            </button>
        </form>
    }
</div>

<div class="app-card">
    <ul class="nav app-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-tab" type="button" role="tab"
                    data-bs-toggle="tab" data-bs-target="#general" data-tab-hash="general"
                    aria-controls="general" aria-selected="true">General</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="clients-tab" type="button" role="tab"
                    data-bs-toggle="tab" data-bs-target="#clients" data-tab-hash="clients"
                    aria-controls="clients" aria-selected="false">
                Client(s)
                @if (!Model.IsNew)
                {
                    <span class="tab-count" data-tab-count hidden></span>
                }
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active app-card-body" id="general" role="tabpanel" aria-labelledby="general-tab" tabindex="0">
            <form class="form-narrow" asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.ContactId" method="post" novalidate
                  data-dirty-check="@(Model.IsNew ? null : ViewData.ModelState.IsValid ? "clean" : "start-dirty")">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="ContactId" />

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Name" class="form-label required"></label>
                        <input asp-for="Name" class="form-control" autocomplete="off" autofocus />
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Surname" class="form-label required"></label>
                        <input asp-for="Surname" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Surname"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label required"></label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" data-dirty-submit
                            disabled="@(!Model.IsNew && ViewData.ModelState.IsValid)">
                        <icon name="check" /> @(Model.IsNew ? "Create contact" : "Save changes")
                    </button>
                    <a asp-action="Index" class="btn btn-light">Cancel</a>
                </div>
            </form>
        </div>

        <div class="tab-pane fade" id="clients" role="tabpanel" aria-labelledby="clients-tab" tabindex="0">
            @if (Model.IsNew)
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><icon name="building" /></div>
                    <p class="empty-message">Save the contact first</p>
                    <p class="empty-hint">You can link clients once the contact has been created.</p>
                </div>
            }
            else
            {
                <div data-link-panel data-load-url="@Url.Action("Clients", new { id = Model.ContactId })"
                     data-unlink-url="@Url.Action("UnlinkClients", new { id = Model.ContactId })"
                     data-field-name="clientIds" data-noun="client" data-noun-plural="clients"
                     data-owner="this contact">
                    <div class="empty-state"><div class="spinner-border text-secondary" role="status"><span class="visually-hidden">Loading clients…</span></div></div>
                </div>
            }
        </div>
    </div>
</div>

@if (!Model.IsNew)
{
    @await Html.PartialAsync("_LinkPickerModal", new LinkPickerViewModel(
        "Link clients",
        "client",
        "clients",
        Url.Action("ClientOptions", new { id = Model.ContactId })!,
        Url.Action("LinkClients", new { id = Model.ContactId })!,
        "clientIds",
        "Search by client name or code"))
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/link-panel.js" asp-append-version="true"></script>
}
