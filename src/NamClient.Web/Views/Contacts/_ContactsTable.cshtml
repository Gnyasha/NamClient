@model ListPageViewModel<ContactListItemViewModel>
@{
    var page = Model.Page;
    var request = Model.Request;

    // Leave defaults out of URLs so they stay short and shareable.
    string? SortParam(string sort) => sort == "name" ? null : sort;
    int? SizeParam() => request.PageSize == PageRequest.DefaultPageSize ? null : request.PageSize;

    string ListUrl(string sort, string? after = null, string? before = null) =>
        Url.Action("Index", new { q = request.Search, sort = SortParam(sort), size = SizeParam(), after, before })!;

    SortHeaderViewModel Header(string label, string key, string css)
    {
        var header = new SortHeaderViewModel(label, key, Model.Sort, string.Empty, css);
        return header with { Url = ListUrl(header.NextSort) };
    }
}

@if (page.Items.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><icon name="@(request.HasSearch ? "search" : "users")" /></div>
        <p class="empty-message">No contact(s) found.</p>
    </div>
}
else
{
    <div class="data-table-wrap">
        <table class="table table-hover data-table align-middle">
            <caption class="visually-hidden">Contacts, ordered by full name (surname, then name). Select a row to open the contact.</caption>
            <thead>
                <tr>
                    <th class="col-select" scope="col">
                        <input class="form-check-input" type="checkbox" data-select-all aria-label="Select all contacts on this page" />
                    </th>
                    <th class="text-start" scope="col">Name</th>
                    @await Html.PartialAsync("_SortHeader", Header("Surname", "name", "text-start"))
                    @await Html.PartialAsync("_SortHeader", Header("Email address", "email", "text-start"))
                    <th class="text-center" scope="col">No. of linked clients</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in page.Items)
                {
                    <tr data-href="@Url.Action("Edit", new { id = contact.ContactId })" data-id="@contact.ContactId">
                        <td class="col-select">
                            <input class="form-check-input" type="checkbox" data-select value="@contact.ContactId" aria-label="Select @contact.Surname @contact.Name" />
                        </td>
                        <td class="text-start">
                            <a class="row-title" asp-action="Edit" asp-route-id="@contact.ContactId">@contact.Name</a>
                        </td>
                        <td class="text-start">@contact.Surname</td>
                        <td class="text-start">@contact.Email</td>
                        <td class="text-center"><span class="count-pill">@contact.LinkedClientCount.ToString("0")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerViewModel(
        page.Items.Count,
        page.TotalCount,
        page.TotalIsLowerBound,
        request.HasSearch ? "matching contacts" : "contacts",
        page.HasPrevious ? ListUrl(Model.Sort, before: page.PreviousCursor) : null,
        page.HasNext ? ListUrl(Model.Sort, after: page.NextCursor) : null))
}
